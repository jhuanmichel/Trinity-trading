# ============================================================
# CRYPTO AGENT — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores
# NUNCA suba o .env para o GitHub!
# ============================================================

# --- MEXC API ---
MEXC_API_KEY=sua_api_key_aqui
MEXC_SECRET_KEY=sua_secret_key_aqui

# --- AI (escolha uma) ---
ANTHROPIC_API_KEY=sua_chave_claude_aqui
# OPENAI_API_KEY=sua_chave_openai_aqui

# --- TELEGRAM ---
TELEGRAM_TOKEN=token_do_botfather_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- COINGLASS (dados de derivativos + liquidações) ---
# Plano gratuito: https://www.coinglass.com/pricing
COINGLASS_API_KEY=sua_chave_coinglass_aqui

# --- CRYPTOQUANT (dados derivados on-chain) ---
# Plano gratuito: https://cryptoquant.com/
CRYPTOQUANT_API_KEY=sua_chave_cryptoquant_aqui

# --- GLASSNODE (on-chain) ---
# Plano gratuito: https://glassnode.com
GLASSNODE_API_KEY=sua_chave_glassnode_aqui

# --- CONFIGURAÇÕES DO AGENTE ---
SYMBOL=BTC/USDT:USDT           # Par de futuros MEXC
TIMEFRAME=15m                  # Timeframe principal
SCORE_THRESHOLD=65             # Score mínimo para gerar sinal (0-100)
SUMMARY_INTERVAL_MINUTES=120   # Resumo simples (preço, score, sinal) — sem IA
SIGNAL_INTERVAL_MINUTES=240   # Análise + Claude + sinal completo (entrada, stop, alvos)
